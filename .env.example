# Copy to .env — do not commit secrets.
GOOGLE_CLOUD_PROJECT=permit-pilot-vertex-20260829
VERTEX_LOCATION=global

# Use gcloud ADC (recommended): gcloud auth application-default login
# Or service account: GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Model roles (PRD §6.2)
MODEL_PLANNER=gemini-3.1-pro-preview
MODEL_WORKER=gemini-3.5-flash
MODEL_AUDITOR=gemini-3.1-pro-preview
MODEL_ARBITER=gemini-3.1-pro-preview
MODEL_SMOKE=gemini-3.1-flash-lite

# Sibyl Memory (local-first)
SIBYL_MEMORY_DB=demo-data/memory.db

# Demo
DEMO_COMMIT_TAG=demo-v1
HUMAN_GATE_CONFIDENCE_THRESHOLD=0.85
WALLET_CAP_USDC=2.00

# Onchain — Base Sepolia for settlement ($0 via CDP faucet)
ONCHAIN_NETWORK=base-sepolia
BASE_RPC_URL=https://sepolia.base.org
B20_RPC_URL=https://mainnet.base.org

# CDP Agentic Wallet + x402 (portal.cdp.coinbase.com)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Virtuals ACP — testnet only (IS_TESTNET=true make setup-acp)
IS_TESTNET=true
ACP_CHAIN_ID=84532
ACP_PROVIDER_ADDRESS=
ACP_OFFERING_NAME=
ACP_REQUIREMENTS_JSON={"location":"Athens"}

# Langfuse (optional self-host)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
